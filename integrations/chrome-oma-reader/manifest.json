{
  "manifest_version": 3,
  "name": "Oma Reader",
  "version": "0.1.0",
  "description": "Lets Oma AI on this PC read the text of any open tab, also a tab in the background, without switching to it. Read-only; it talks only to Oma on this PC.",
  "permissions": ["tabs", "scripting", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "key": ""
}
